{
  "expo": {
    "name": "AfriMarket",
    "slug": "mobil-afrishop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "afrimarket",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "win.africashop.mobile",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Sign in quickly and securely with Face ID"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "win.africashop.mobile",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Sign in quickly and securely with Face ID"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "flavoren",
    "extra": {
      "eas": {
        "projectId": "5f25dabf-c954-4fa3-95ff-31f9ffae4dbd"
      }
    }
  }
}